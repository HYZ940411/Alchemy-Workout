// WSA 課程平台 - Entity Relationship Model
// 用於 TDD 練武單元：課程平台單元進度功能實戰

// 用戶
Table users {
  id integer [primary key, increment]
  name varchar [not null]
  level integer [default: 1, note: '用戶等級']
  exp integer [default: 0, note: '經驗值']
  
  indexes {
    name
  }
}

// 旅程
Table journeys {
  id integer [primary key, increment]
  name varchar [not null]
}

// 章節
Table chapters {
  id integer [primary key, increment]
  journey_id integer [ref: > journeys.id, not null]
  name varchar [not null]
  order_index integer [not null, note: '章節順序']
}

// 課程
Table lessons {
  id integer [primary key, increment]
  name varchar [not null]
  type varchar [not null, note: '影片課程、問卷課程、挑戰題課程']
  journey_id integer [ref: > journeys.id, not null]
  chapter_id integer [ref: > chapters.id, not null]
  reward_exp integer [default: 0, note: '獎勵經驗值']
  
  indexes {
    journey_id
    chapter_id
  }
}

// 課程進度
Table lesson_progress {
  id integer [primary key, increment]
  user_id integer [ref: > users.id, not null]
  lesson_id integer [ref: > lessons.id, not null]
  progress integer [default: 0, note: '進度百分比 0-100']
  status varchar [not null, note: '進行中、已完成、已交付']
  updated_at timestamp [default: `now()`]
  
  indexes {
    (user_id, lesson_id) [unique]
    user_id
    lesson_id
  }
}

// 商品
Table products {
  id integer [primary key, increment]
  name varchar [not null, note: '商品名稱']
  price decimal(10,0) [not null, note: '商品價格']
  description varchar [note: '商品描述']
  plan_items json [not null, note: '商品包含的方案項目陣列']
  status varchar [not null, default: 'ACTIVE', note: 'ACTIVE: 上架中, INACTIVE: 已下架']
  
  indexes {
    status
  }
  
  Note: '''
  商品實體，代表可購買的課程產品
  
  plan_items 結構（JSON Array）：
  [
    {
      "plan_type": "journey_purchased" | "journey_subscription" | "journey_teacher",
      "journey_id": integer,
      "duration_days": integer (選填，僅 journey_subscription 使用，表示訂閱天數)
    }
  ]
  
  plan_type 中英對照：
  - 旅程購買 (journey_purchased)
  - 旅程訂閱狀態 (journey_subscription)
  - 旅程老師 (journey_teacher)
  
  範例：
  - 首購+訂閱商品：
    [
      {"plan_type": "journey_purchased", "journey_id": 1},
      {"plan_type": "journey_subscription", "journey_id": 1, "duration_days": 30}
    ]
  - 單純續訂商品：
    [
      {"plan_type": "journey_subscription", "journey_id": 1, "duration_days": 30}
    ]
  
  約束：
  - price > 0
  - status 只能是 ACTIVE 或 INACTIVE
  - plan_items 至少包含一個項目
  - plan_type 只能是 journey_purchased, journey_subscription, journey_teacher
  '''
}

// 訂單
Table orders {
  id integer [primary key, increment]
  user_id integer [ref: > users.id, not null]
  order_number varchar(18) [unique, not null, note: '訂單編號，格式: yyyyMMddHHmmss+4位隨機碼']
  status varchar [not null, default: 'CREATED', note: 'CREATED: 已建立, PROCESSING: 處理中, PAID: 已付款, COMPLETED: 已完成, CANCELLED: 已取消']
  total_price decimal(10,0) [not null, note: '訂單總價']
  created_at timestamp [default: `now()`, note: '建立時間']
  payment_deadline timestamp [note: '付款期限，建立後 3 天']
  paid_at timestamp [note: '付款時間']
  
  indexes {
    user_id
    order_number [unique]
    status
    payment_deadline
  }
  
  Note: '''
  訂單實體
  
  狀態流轉：
  - CREATED → PROCESSING → PAID → COMPLETED
  - CREATED → CANCELLED
  - PROCESSING → CANCELLED
  
  約束：
  - total_price >= 0
  - payment_deadline = created_at + 3 天
  '''
}

// 訂單項目
Table order_items {
  id integer [primary key, increment]
  order_id integer [ref: > orders.id, not null]
  product_id integer [ref: > products.id, not null]
  product_name varchar [not null, note: '商品名稱快照']
  price decimal(10,0) [not null, note: '購買時的單價']
  quantity integer [not null, default: 1, note: '購買數量']
  
  indexes {
    order_id
    product_id
  }
  
  Note: '''
  訂單項目實體
  
  約束：
  - quantity > 0
  - price >= 0
  '''
}

// 折扣券
Table coupons {
  id integer [primary key, increment]
  user_id integer [ref: > users.id, not null]
  code varchar [not null, note: '折扣券代碼']
  name varchar [not null, note: '折扣券名稱']
  type varchar [not null, note: 'DISCOUNT: 折扣, VOUCHER: 抵用券']
  value decimal(10,2) [not null, note: '折扣值，DISCOUNT 為折扣比例(0-1)，VOUCHER 為抵用金額']
  order_id integer [ref: > orders.id, note: '使用在哪個訂單，null 表示未使用']
  expired_at timestamp [note: '過期時間']
  
  indexes {
    user_id
    code
    order_id
  }
  
  Note: '''
  折扣券實體
  
  約束：
  - type 為 DISCOUNT 時，value 範圍 0-1
  - type 為 VOUCHER 時，value > 0
  - 一個折扣券只能使用一次
  '''
}

// 付款請求
Table payment_requests {
  id integer [primary key, increment]
  order_id integer [ref: > orders.id, not null]
  payment_method varchar [not null, note: 'CREDIT: 信用卡, ATM: ATM轉帳, BNPL: 無卡分期']
  payment_provider varchar [note: 'SYSPAY: 藍新金流, ZINGALA: 中租零卡分期']
  amount decimal(10,0) [not null, note: '付款金額']
  request_time timestamp [default: `now()`, note: '請求時間']
  
  indexes {
    order_id
    payment_method
  }
  
  Note: '''
  付款請求實體，記錄訂單的付款請求
  
  約束：
  - amount > 0
  - amount = 對應 order 的 total_price
  '''
}

// 角色
Table roles {
  id integer [primary key, increment]
  user_id integer [ref: > users.id, not null]
  role_type varchar [not null, note: 'journey_purchased, journey_subscription, journey_teacher']
  journey_id integer [ref: > journeys.id, not null, note: '關聯的旅程 ID']
  granted_at timestamp [default: `now()`, note: '授予時間']
  revoked_at timestamp [null, note: '撤銷時間，null 表示角色仍有效']
  
  indexes {
    (user_id, role_type, journey_id) [unique]
    user_id
    journey_id
    role_type
  }
  
  Note: '''
  角色表，記錄用戶在特定旅程中的角色
  
  role_type 中英對照：
  - 旅程購買 (journey_purchased): 已購買旅程（完成付款的訂單）
  - 旅程訂閱狀態 (journey_subscription): 旅程訂閱中（有效的訂閱資格）
  - 旅程老師 (journey_teacher): 旅程老師
  
  約束：
  - 同一用戶在同一旅程中不可重複擁有同一 role_type
  - revoked_at 為 null 時表示角色有效
  '''
}
