rules_version = '2';

// 健金術 Alchemy Workout —— Firestore 安全規則
//
// **這是 [BE-04]＋[BE-12]＋[BE-11 批次 1–6] 的版本，仍不是完整版。**
// 目前涵蓋「使用者私有資料限本人讀寫」與「平台公用資料使用者唯讀、
// 管理端（custom claim）寫入」兩條。
// `Firestore-Schema設計.md` 第 7 節規劃的完整規則（經濟/信任類子路徑
// 收斂成僅 Cloud Functions 可寫、跨使用者關聯資料的可見性判斷、
// 管理員 custom claim）尚未實作，等 [BE-07] 把評分邏輯搬上 Cloud Functions
// 之後才有意義 —— 在那之前把欄位鎖成「客戶端不可寫」，App 自己就動不了。
//
// 換句話說：**現階段客戶端仍可竄改自己的金幣與能力值。**
// 這與現況（資料存在本機、改記憶體就能上排行榜）相比沒有變得更差，
// 但也還沒變好，見 PROGRESS.md 第 5 節第 1 點。

service cloud.firestore {
  match /databases/{database}/documents {

    // 管理員 —— 靠 custom claim，不靠某個 collection 的內容。
    // import 工具以 service account（Admin SDK）寫入種子，完全繞過本規則，
    // 不受此判斷影響。
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // --- 使用者私有資料 ---
    //
    // 整棵 users/{uid} 子樹只有本人能讀寫。這條規則同時涵蓋根文件與
    // 其下所有子集合（ability/state、streaks/*、wallet/*、history/* 等），
    // 靠的是最後那個 {document=**} 遞迴萬用字元。
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // --- 公開檔案（[BE-11] 批次 1）---
    //
    // 整個模型裡第一個「別人讀得到我的資料」的集合。
    // 登入者皆可讀（要看得到平台上還有誰），**只有本人可寫**。
    //
    // 內容是刻意挑過的：暱稱、階級、（依可見度開關的）能力值、粉絲數、
    // 教官身分與聲望。身高體重、生日、電子郵件、處罰狀態、違規次數
    // 全部留在 users/{uid} 那棵只有本人可讀的樹裡 ——
    // **安全規則的粒度是文件，不是欄位**，所以「有些欄位公開」
    // 唯一可靠的做法就是把它們拆成另一份文件。
    match /public_profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // --- 師徒（[BE-11] 批次 6）---
    //
    // 只有當事的兩人讀得到。師徒之間的問答與任務是私密的指導內容，
    // 與私訊同等級 —— 不是登入就能看的公開資料。
    function inBond(bondId) {
      return request.auth != null
             && (get(/databases/$(database)/documents/mentor_bonds/$(bondId))
                   .data.mentorUid == request.auth.uid
                 || get(/databases/$(database)/documents/mentor_bonds/$(bondId))
                      .data.apprenticeUid == request.auth.uid);
    }

    match /mentor_bonds/{bondId} {
      allow read: if request.auth != null
                  && (resource.data.mentorUid == request.auth.uid
                      || resource.data.apprenticeUid == request.auth.uid);
      allow create: if request.auth != null
                    && (request.resource.data.mentorUid == request.auth.uid
                        || request.resource.data.apprenticeUid == request.auth.uid);
      // 解除與恢復都是狀態轉換，雙方皆可（規格：兩方都能提出解除）。
      allow update: if request.auth != null
                    && (resource.data.mentorUid == request.auth.uid
                        || resource.data.apprenticeUid == request.auth.uid);
      // **關係不硬刪** —— 已解除是狀態，不是消失；三天內還能恢復。
      allow delete: if false;

      match /tasks/{taskId} {
        allow read, write: if inBond(bondId);
      }
      match /questions/{questionId} {
        allow read, write: if inBond(bondId);
      }
    }

    // 師徒申請。收件者與寄件者都看得到自己那一份。
    match /mentor_requests/{requestId} {
      allow read: if request.auth != null
                  && (resource.data.toUid == request.auth.uid
                      || resource.data.fromUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;
      // 收件者拒絕、寄件者收回，兩者都是刪掉這一筆。
      allow delete: if request.auth != null
                    && (resource.data.toUid == request.auth.uid
                        || resource.data.fromUid == request.auth.uid);
      allow update: if false;
    }

    // --- 私訊（[BE-11] 批次 5）---
    //
    // 只有對話的兩位參與者讀得到。這是整份規則裡**唯一完全私密**的
    // 跨使用者資料 —— 貼文、團隊、公開檔案都是登入即可讀。
    //
    // **訊息一經發送不可刪除、不可編輯**（規格明訂）。所以 messages
    // 只允許 create，唯一的例外是已讀狀態：任一參與者都要能標記自己讀過，
    // 那必須改到對方送的那則訊息上。用 affectedKeys 限制成只能動 readBy。
    // **從對話 ID 直接算出參與者，不去 `get()` 那份文件。**
    //
    // 原本這裡對對話文件做 `get()`。但第一次傳訊息給某人時，對話文件
    // 與訊息是**同一個 batch 寫進去的**，而規則的 `get()` 看的是 batch
    // 之前的狀態 —— 文件還不存在，規則拒絕，整個 batch 被退回。
    // 也就是**對任何人的第一則訊息一定失敗**，而客戶端是即發即忘、
    // 吞掉錯誤，所以完全看不出來。
    //
    // 對話 ID 由兩個 uid 排序後以底線相接（見 `conversationIdOf`），
    // 參與者本來就編碼在 ID 裡，不需要再讀一次文件 —— 也省一次讀取。
    function convParties(convId) {
      return convId.split('_');
    }
    function inConversation(convId) {
      return request.auth != null
             && request.auth.uid in convParties(convId);
    }

    match /conversations/{convId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;
      // 參與者可更新（lastAt、單方刪除的 deletedBy）。
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;
      // **對話不硬刪** —— 刪除是單方的，只改自己那一側的 deletedBy。
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if inConversation(convId);
        allow create: if inConversation(convId)
                      && request.resource.data.senderUid == request.auth.uid;
        // 唯一允許的更新：標記自己已讀。內容、發送者、時間都動不了。
        allow update: if inConversation(convId)
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['readBy']);
        allow delete: if false;
      }
    }

    // --- 團隊（[BE-11] 批次 4）---
    //
    // 成員清單內嵌在隊伍文件裡（上限 5 人），所以「改隊伍」與「改成員」
    // 是同一份文件的寫入，規則也就只有一條。
    function teamMemberUids(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId))
               .data.memberUids;
    }
    function isTeamMember(teamId) {
      return request.auth != null
             && request.auth.uid in teamMemberUids(teamId);
    }

    match /teams/{teamId} {
      allow read: if request.auth != null;

      // 建立者必須把自己放進成員裡 —— 不能開一支自己不在的隊。
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberUids;

      allow update: if request.auth != null && (
                      // 隊員可以改隊伍（加人、踢人、改可見性、解散）
                      request.auth.uid in resource.data.memberUids
                      // 或者：有一筆給我的待回應請求，而我正把自己加進去
                      // （接受邀請／申請被核准後自己入隊這條路徑）
                      || (exists(/databases/$(database)/documents/teams/$(teamId)/requests/$(request.auth.uid))
                          && request.auth.uid in request.resource.data.memberUids)
                    );

      // **解散是軟刪除**（disbanded 欄位）—— 排行榜歷史仍要查得到這支隊伍。
      allow delete: if false;

      // 邀請與申請共用一份文件，isInvite 區分方向。
      // 文件 ID 是對象的 uid，所以同一人對同一隊只會有一筆。
      match /requests/{targetUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && (
                        // 我自己申請加入
                        (request.resource.data.isInvite == false
                         && targetUid == request.auth.uid)
                        // 或隊員邀請別人
                        || (request.resource.data.isInvite == true
                            && isTeamMember(teamId))
                      );
        // 當事人可以拒絕／收回，隊員可以撤銷或在核准後清掉。
        allow delete: if request.auth != null
                      && (targetUid == request.auth.uid || isTeamMember(teamId));
        allow update: if false;
      }
    }

    // **collection group 查詢吃的不是上面那條巢狀規則。**
    //
    // `collectionGroup('requests')`（「誰邀我入隊」）在規則引擎眼中，
    // 比對的是帶遞迴萬用字元的路徑，不是 `/teams/{teamId}/requests/...`
    // —— 巢狀規則只適用於明確從那個路徑出發的查詢。少了這一條，
    // 那個查詢一律 PERMISSION_DENIED。
    //
    // 而 `requestsFor()` 先查邀請、再查申請：邀請被拒就整個丟例外，
    // **後面查「誰申請加入我的隊」那一段根本沒跑到**。呼叫端又是
    // 即發即忘，於是隊長那一側安靜地永遠是空的。
    //
    // 放行範圍與上面那條巢狀規則完全一樣（登入即可讀），沒有放寬。
    // 全專案只有 teams 底下有名為 requests 的子集合（師徒走的是
    // 頂層 mentor_requests），所以這條打不到別的東西。
    match /{path=**}/requests/{targetUid} {
      allow read: if request.auth != null;
    }

    // --- 檢舉 ---
    //
    // **只進不出。** 一般使用者可以送出檢舉，但讀不到佇列 ——
    // 那裡面有別人的違規內容、檢舉者的身分與累計違規次數。
    // 讀取與裁決屬於管理端（custom claim）。
    //
    // 文件 ID 是「標的＋檢舉者」，所以同一人對同一標的只有一筆；
    // `set` 會覆寫自己那筆（改了檢舉理由再送一次），這是對的。
    // 不給 update/delete：送出後自己撤不掉 —— 案件是給管理員看的，
    // 被檢舉者若能誘使檢舉者撤回，這個機制就沒有意義了。
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
                    && request.resource.data.reporterUid == request.auth.uid;
      allow update: if isAdmin()
                    || (request.auth != null
                        && resource.data.reporterUid == request.auth.uid
                        && request.resource.data.reporterUid
                             == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- 貼文、留言、按讚（[BE-11] 批次 3）---
    //
    // 這裡有一個規則設計上的難處：**按讚的人不是作者，卻必須能改貼文**
    // —— 因為 likeCount 存在貼文文件上。若只允許作者寫，按讚就寫不進去；
    // 若允許任何人寫，別人就能改你的貼文內容。
    //
    // 解法是用 diff().affectedKeys()：其他人可以更新這份文件，
    // **但這次更新只准動到 likeCount 這一個欄位**。
    //
    // 計數本身仍可被竄改（有心人可以不按讚而直接加十次），
    // 與金幣、能力值一樣要等 [BE-07] 搬上 Cloud Functions 才擋得住。
    // 現階段它至少不能改別人的文字。
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid;
      //
      // **管理員也要能改** —— 檢舉成立時要下架違規內容，而那是改**別人的**
      // 貼文。少了這一條，管理員在後台按下「成立」，畫面上內容消失了，
      // 雲端那份一個位元都沒動，其他人照樣看得到。
      // 那正是這個專案反覆出現的那種失敗：畫面成功、雲端無聲拒絕。
      allow update: if request.auth != null && (
                      resource.data.authorUid == request.auth.uid
                      || isAdmin()
                      || request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['likeCount'])
                    );
      // **貼文一律軟刪除**（deleted 欄位），不給硬刪 ——
      // 貼文可被檢舉，硬刪會讓案件失去證據。管理員同樣只能軟刪。
      allow delete: if false;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.authorUid == request.auth.uid;
        // 同上：檢舉成立時管理員要下架別人的留言。
        allow update: if request.auth != null
                      && (resource.data.authorUid == request.auth.uid
                          || isAdmin());
        allow delete: if false; // 同樣軟刪除
      }

      // 文件 ID 就是按讚者的 uid —— 一人一次由主鍵保證，
      // 而「只能替自己按」由這條規則保證。
      match /likes/{likerUid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
                              && likerUid == request.auth.uid;
        allow update: if false; // 按讚沒有「修改」這回事
      }
    }

    // --- 累計違規次數（[BE-13]，2026-09-25）---
    //
    // 階梯累犯制的級距由這個數字決定，所以它**必須是當事人自己改不動的**。
    // 既有的兩個候選位置都不行：`public_profiles/{uid}` 與 `users/{uid}/…`
    // 的規則都是「本人可寫」—— 他自己就能清掉。所以另開一份。
    //
    // 當事人讀得到自己的（處罰畫面要告訴他這是第幾次），
    // 但讀不到別人的 —— 誰被罰過幾次不是公開資訊。
    match /violations/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // --- 申訴（[BE-13]，2026-09-25）---
    //
    // 文件 ID 是 `{申訴人 uid}__{處罰開出的毫秒時戳}`，所以
    // **同一筆處罰只能申訴一次**由主鍵保證，不是靠客戶端先查再寫。
    //
    // 申訴人讀得到自己那幾筆（要看審視進度），讀不到別人的。
    // 裁決只有管理員寫得動 —— 不然他自己就能把申訴改成「已成立」。
    match /appeals/{appealId} {
      allow read: if request.auth != null
                  && (resource.data.appellantUid == request.auth.uid
                      || isAdmin());
      allow create: if request.auth != null
                    && request.resource.data.appellantUid == request.auth.uid
                    && request.resource.data.state == 'pending';
      allow update: if isAdmin();
      // **申訴不硬刪** —— 它是處罰是否公正的紀錄，兩造都不該刪得掉。
      allow delete: if false;
    }

    // --- 處罰狀態（[BE-13]，2026-09-25）---
    //
    // 與違規次數同一個形狀：管理員可寫、當事人唯讀。存在本人寫得動的
    // 地方（存檔、public_profiles）的話，被罰的人自己就能解除。
    //
    // **唯一的例外是申訴** —— 那是當事人發起的，所以他改得動
    // `appealed` 與 `appealState` 這兩個欄位，但**只有這兩個**。
    // 用 affectedKeys 限住，與貼文 likeCount 同一個手法：
    // 少了這層，他就能把自己的處罰種類改成「警告」。
    match /punishments/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (request.auth != null
                        && request.auth.uid == uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['appealed', 'appealState']));
    }

    // --- 關注關係（[BE-11] 批次 2）---
    //
    // 文件 ID 是 {followerUid}_{followeeUid}，所以「同一組關係只有一筆」
    // 由主鍵保證。規則要管的是**只有關注者本人能建立或移除自己發出的關注**
    // —— 不擋的話任何人都能替別人按關注，粉絲數就成了誰都能改的數字。
    //
    // 建立時看 request.resource（即將寫入的內容），
    // 刪除時看 resource（already 存在的那份）—— 兩者不可混用。
    match /follows/{edge} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.followerId == request.auth.uid;
      // 關注沒有「修改」這回事：要嘛存在、要嘛不存在。
      allow update: if false;
    }

    // --- 平台公用唯讀資料（[BE-12]）---
    //
    // 動作庫、訓練計畫、平台設定、成就定義、每日任務池（獎勵定義併入
    // platform_config 的 reward 群組，不另立集合）。
    // **一般使用者唯讀、管理端寫入** —— 見 Firestore-Schema設計.md §7。
    // 寫入收斂到 custom claim 管理員；這類設定沒有跨文件金流不變條件，
    // 直接用規則放行即可，不需 Cloud Functions，故 [BE-12] 續留免費方案。
    // change_log 子集合（稽核）靠 {document=**} 一併涵蓋。
    match /exercises/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /plans/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /platform_config/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /achievement_defs/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /daily_task_pool/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // --- 其餘一律拒絕 ---
    //
    // 尚未上雲的跨使用者關聯資料（檢舉／申訴…見 [BE-13]）與其他集合
    // 落在這裡。要開放時再加對應 match 區塊，不先開一個大洞等著填。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
